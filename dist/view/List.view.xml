<mvc:View
    controllerName="inventoryportal.controller.List"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        title="{i18n>productList}"
        busy="{view>/busy}"
        busyIndicatorDelay="0">

        <headerContent>
            <SearchField
                width="20rem"
                placeholder="{i18n>searchProducts}"
                liveChange=".onSearch" />
        </headerContent>

        <content>
            <List
                id="productList"
                items="{products>/products}"
                mode="SingleSelectMaster"
                itemPress=".onItemPress"
                updateFinished=".onListUpdateFinished"
                noDataText="{i18n>noProducts}">

                <headerToolbar>
                    <OverflowToolbar>
                        <Title
                            text="{= ${i18n>productsLabel} + ' (' + ${view>/visibleCount} + ')' }" />

                        <ToolbarSpacer />

                        <Button
                            icon="sap-icon://add"
                            text="{i18n>addProduct}"
                            press=".onAddProduct" />

                        <Button
                            icon="sap-icon://sort"
                            text="{i18n>sort}"
                            press=".onOpenSort" />

                        <Button
                            icon="sap-icon://filter"
                            text="{i18n>filter}"
                            press=".onOpenFilter" />

                        <Button
                            icon="sap-icon://group-2"
                            text="{i18n>group}"
                            press=".onOpenGroup" />
                    </OverflowToolbar>
                </headerToolbar>

                <items>
                    <ObjectListItem
                        title="{products>name}"
                        number="{
                            parts: [
                                'products>price',
                                'products>currency'
                            ],
                            formatter: '.formatter.formatCurrency'
                        }"
                        type="Navigation">

                        <firstStatus>
                            <ObjectStatus
                                text="{
                                    parts: [
                                        'products>stock',
                                        'products>reorderThreshold'
                                    ],
                                    formatter: '.formatter.getStockStatus'
                                }"
                                state="{
                                    parts: [
                                        'products>stock',
                                        'products>reorderThreshold'
                                    ],
                                    formatter: '.formatter.getStockState'
                                }"
                                icon="{
                                    parts: [
                                        'products>stock',
                                        'products>reorderThreshold'
                                    ],
                                    formatter: '.formatter.getStockIcon'
                                }" />
                        </firstStatus>

                        <attributes>
                            <ObjectAttribute
                                text="{products>category}" />
                        </attributes>
                    </ObjectListItem>
                </items>
            </List>
        </content>
    </Page>

</mvc:View>
