<mvc:View
    controllerName="inventoryportal.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form">

    <Page
        title="{i18n>productDetails}"
        busy="{view>/busy}"
        busyIndicatorDelay="0"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <headerContent>
            <Button
                icon="sap-icon://edit"
                text="{i18n>edit}"
                press=".onEdit" />

            <Button
                icon="sap-icon://shipping-status"
                text="{i18n>reorder}"
                press=".onReorder" />

            <Button
                icon="sap-icon://delete"
                text="{i18n>delete}"
                type="Reject"
                press=".onDelete" />
        </headerContent>

        <content>
            <ObjectHeader
                title="{products>name}"
                icon="{products>imageUrl}"
                number="{
                    parts: [
                        'products>price',
                        'products>currency'
                    ],
                    formatter: '.formatter.formatCurrency'
                }">

                <firstStatus>
                    <ObjectStatus
                        text="{
                            parts: [
                                'products>stock',
                                'products>reorderThreshold'
                            ],
                            formatter: '.formatter.getStockStatus'
                        }"
                        state="{
                            parts: [
                                'products>stock',
                                'products>reorderThreshold'
                            ],
                            formatter: '.formatter.getStockState'
                        }"
                        icon="{
                            parts: [
                                'products>stock',
                                'products>reorderThreshold'
                            ],
                            formatter: '.formatter.getStockIcon'
                        }" />
                </firstStatus>

                <attributes>
                    <ObjectAttribute
                        title="{i18n>category}"
                        text="{products>category}" />
                    <ObjectAttribute
                        title="{i18n>sku}"
                        text="{products>sku}" />
                </attributes>
            </ObjectHeader>

            <form:SimpleForm
                editable="false"
                layout="ResponsiveGridLayout"
                title="{i18n>productInformation}"
                class="sapUiResponsiveMargin">

                <Label text="{i18n>description}" />
                <Text text="{products>description}" />

                <Label text="{i18n>supplier}" />
                <Text text="{products>supplier}" />

                <Label text="{i18n>warehouse}" />
                <Text text="{products>warehouse}" />

                <Label text="{i18n>stock}" />
                <Text text="{products>stock}" />

                <Label text="{i18n>reorderThreshold}" />
                <Text text="{products>reorderThreshold}" />

                <Label text="{i18n>lastUpdated}" />
                <Text
                    text="{
                        path: 'products>lastUpdated',
                        formatter: '.formatter.formatDate'
                    }" />
            </form:SimpleForm>
        </content>
    </Page>

</mvc:View>
