<mvc:View
    controllerName="inventoryportal.controller.NotFound"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        title="{i18n>notFoundTitle}">

        <content>
            <VBox
                alignItems="Center"
                justifyContent="Center"
                class="sapUiLargeMargin">

                <Title
                    text="{i18n>notFoundMessage}"
                    level="H2" />

                <Button
                    text="{i18n>backToProducts}"
                    press=".onNavBack"
                    class="sapUiMediumMarginTop" />
            </VBox>
        </content>
    </Page>

</mvc:View>
