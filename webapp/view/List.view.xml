<mvc:View
    controllerName="inventoryportal.controller.List"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

<Page
    title="{i18n>productList}">

    <headerContent>

        <SearchField
            width="20rem"
            liveChange=".onSearch"/>

    </headerContent>

    <content>

        <List

            id="productList"

            items="{
                path:'ProductModel>/products'
            }"

            mode="SingleSelectMaster"

            itemPress=".onItemPress"

            noDataText="{i18n>noProducts}">

            <headerToolbar>

                <OverflowToolbar>

                    <Title
                        text="{= 'Products (' + ${ProductModel>/products}.length + ')' }"/>

                    <ToolbarSpacer/>

                    <Button
                        icon="sap-icon://add"
                        text="{i18n>addProduct}"
                        press=".onAddProduct"/>

                    <Button
                        icon="sap-icon://sort"
                        press=".onOpenSort"/>

                    <Button
                        icon="sap-icon://filter"
                        press=".onOpenFilter"/>

                </OverflowToolbar>

            </headerToolbar>

            <ObjectListItem

                title="{products>name}"

                number="{
                    parts:[
                        'products>price',
                        'products>currency'
                    ],
                    formatter:'.formatter.formatCurrency'
                }"

                type="Navigation">

                <firstStatus>

                    <ObjectStatus

                        text="{
                            parts:[
                                'products>stock',
                                'products>reorderThreshold'
                            ],
                            formatter:'.formatter.getStockStatus'
                        }"

                        state="{
                            parts:[
                                'products>stock',
                                'products>reorderThreshold'
                            ],
                            formatter:'.formatter.getStatusState'
                        }"/>

                </firstStatus>

                <attributes>

                    <ObjectAttribute
                        text="{products>category}"/>

                </attributes>

            </ObjectListItem>

        </List>

    </content>

</Page>

</mvc:View>