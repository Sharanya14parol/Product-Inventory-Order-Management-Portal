<mvc:View
    controllerName="inventoryportal.controller.List"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        title="{i18n>productList}"
        busy="{view>/busy}"
        busyIndicatorDelay="0"
    >

        <headerContent>
            <SearchField
                width="20rem"
                placeholder="{i18n>searchProducts}"
                liveChange=".onSearch"
            />
        </headerContent>

        <content>
            <List
                id="productList"
                items="{products>/products}"
                mode="SingleSelectMaster"
                itemPress=".onItemPress"
                updateFinished=".onListUpdateFinished"
                noDataText="{i18n>noProducts}"
            >

                <headerToolbar>
                    <OverflowToolbar>

                        <Title
                            text="{= ${i18n>productsLabel} + ' (' + ${view>/visibleCount} + ')' }"
                        />

                        <ToolbarSpacer />

                        <Button
                            icon="sap-icon://add"
                            text="{i18n>addProduct}"
                            press=".onAddProduct"
                        />

                        <Button
                            icon="sap-icon://sort"
                            text="{i18n>sort}"
                            press=".onOpenSort"
                        />

                        <Button
                            icon="sap-icon://filter"
                            text="{i18n>filter}"
                            press=".onOpenFilter"
                        />

                        <Button
                            icon="sap-icon://group-2"
                            text="{i18n>group}"
                            press=".onOpenGroup"
                        />

                    </OverflowToolbar>
                </headerToolbar>

                <items>

                    <CustomListItem
                        type="Navigation"
                        press=".onItemPress"
                    >

                        <HBox
                            width="100%"
                            height="7rem"
                            alignItems="Center"
                            class="sapUiSmallMarginBegin sapUiSmallMarginEnd"
                        >

                            <!-- PRODUCT IMAGE -->
                            <Image
                                src="{products>imageUrl}"
                                width="8rem"
                                height="6rem"
                                densityAware="false"
                                decorative="false"
                                alt="{products>name}"
                                class="sapUiSmallMarginEnd"
                            />

                            <!-- PRODUCT INFORMATION -->
                            <VBox
                                width="100%"
                                justifyContent="Center"
                            >

                                <Title
                                    text="{products>name}"
                                    level="H4"
                                />

                                <Text
                                    text="{products>description}"
                                    wrapping="true"
                                    maxLines="2"
                                    class="sapUiTinyMarginTop"
                                />

                                <HBox
                                    alignItems="Center"
                                    class="sapUiTinyMarginTop"
                                >

                                    <Text
                                        text="{= 'Category: ' + ${products>category} }"
                                        class="sapUiSmallMarginEnd"
                                    />

                                    <Text
                                        text="{= 'SKU: ' + ${products>sku} }"
                                    />

                                </HBox>

                            </VBox>

                            <!-- PRICE -->
                            <VBox
                                width="8rem"
                                alignItems="End"
                                justifyContent="Center"
                                class="sapUiSmallMarginBegin sapUiSmallMarginEnd"
                            >

                                <ObjectNumber
                                    number="{products>price}"
                                    unit="{products>currency}"
                                    emphasized="false"
                                />

                            </VBox>

                            <!-- STOCK -->
                            <VBox
                                width="7rem"
                                alignItems="Center"
                                justifyContent="Center"
                                class="sapUiSmallMarginEnd"
                            >

                                <Text
                                    text="Stock"
                                />

                                <ObjectStatus
                                    text="{products>stock}"
                                    state="{
                                        parts: [
                                            'products>stock',
                                            'products>reorderThreshold'
                                        ],
                                        formatter: '.formatter.getStockState'
                                    }"
                                    icon="{
                                        parts: [
                                            'products>stock',
                                            'products>reorderThreshold'
                                        ],
                                        formatter: '.formatter.getStockIcon'
                                    }"
                                />

                            </VBox>

                        </HBox>

                    </CustomListItem>

                </items>

            </List>
        </content>

    </Page>
</mvc:View>

