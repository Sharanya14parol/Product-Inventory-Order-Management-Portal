{
    "_version": "1.60.0",

    "sap.app": {
        "id": "inventoryportal",
        "type": "application",
        "title": "Inventory Portal",
        "description": "Inventory management application",
        "i18n": "i18n/i18n.properties"
    },

    "sap.ui": {
        "technology": "UI5",

        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },

    "sap.ui5": {

        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.f": {}
            }
        },

        "rootView": {
            "viewName": "inventoryportal.view.App",
            "type": "XML",
            "async": true,
            "id": "app"
        },

        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "inventoryportal.i18n.i18n"
                }
            }
        },

        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },

        "routing": {
    "config": {
        "routerClass": "sap.f.routing.Router",
        "viewType": "XML",
        "viewPath": "inventoryportal.view",
        "controlId": "fcl",
        "controlAggregation": "beginColumnPages",
        "async": true
    },

    "routes": [
        {
            "pattern": "",
            "name": "list",
            "target": "list"
        },
        {
            "pattern": "product/{productId}",
            "name": "detail",
            "target": "detail"
        },
        {
            "pattern": ":all*:",
            "name": "notFound",
            "target": "notFound"
        }
    ],

    "targets": {
        "list": {
            "viewName": "List",
            "viewLevel": 1,
            "controlAggregation": "beginColumnPages"
        },

        "detail": {
            "viewName": "Detail",
            "viewLevel": 2,
            "controlAggregation": "midColumnPages"
        },

        "notFound": {
            "viewName": "NotFound",
            "viewLevel": 1,
            "controlAggregation": "beginColumnPages"
        }
    }
}
    }
}