<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <ViewSettingsDialog
        id="productSettingsDialog"
        confirm=".onConfirmSettings">

        <sortItems>
            <ViewSettingsItem
                text="{i18n>sortByName}"
                key="name" />
            <ViewSettingsItem
                text="{i18n>sortByPrice}"
                key="price" />
            <ViewSettingsItem
                text="{i18n>sortByStock}"
                key="stock" />
        </sortItems>

        <groupItems>
            <ViewSettingsItem
                text="{i18n>groupByCategory}"
                key="category" />
        </groupItems>

        <filterItems>
            <ViewSettingsFilterItem
                text="{i18n>category}"
                key="category"
                multiSelect="true">
                <items>
                    <ViewSettingsItem
                        text="{i18n>categoryHardware}"
                        key="category:Hardware" />
                    <ViewSettingsItem
                        text="{i18n>categoryAccessories}"
                        key="category:Accessories" />
                    <ViewSettingsItem
                        text="{i18n>categoryOffice}"
                        key="category:Office" />
                    <ViewSettingsItem
                        text="{i18n>categoryNetworking}"
                        key="category:Networking" />
                    <ViewSettingsItem
                        text="{i18n>categoryStorage}"
                        key="category:Storage" />
                </items>
            </ViewSettingsFilterItem>

            <ViewSettingsFilterItem
                text="{i18n>stockStatus}"
                key="stockStatus"
                multiSelect="true">
                <items>
                    <ViewSettingsItem
                        text="{i18n>statusAvailable}"
                        key="status:available" />
                    <ViewSettingsItem
                        text="{i18n>statusLowStock}"
                        key="status:low" />
                    <ViewSettingsItem
                        text="{i18n>statusOutOfStock}"
                        key="status:out" />
                </items>
            </ViewSettingsFilterItem>

            <ViewSettingsFilterItem
                text="{i18n>priceRange}"
                key="priceRange"
                multiSelect="true">
                <items>
                    <ViewSettingsItem
                        text="{i18n>priceUnder50}"
                        key="price:low" />
                    <ViewSettingsItem
                        text="{i18n>price50To200}"
                        key="price:medium" />
                    <ViewSettingsItem
                        text="{i18n>priceOver200}"
                        key="price:high" />
                </items>
            </ViewSettingsFilterItem>
        </filterItems>
    </ViewSettingsDialog>

</core:FragmentDefinition>
